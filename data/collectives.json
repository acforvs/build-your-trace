    {
      "id": "all-gather",
      "order": 1,
      "title": "AllGather",
      "summary": "Replicate every rank-owned shard on every rank.",
      "instruction": "Fill each destination tensor with A, B, C in source-rank order. Select a chunk once; it stays selected while you place every copy.",
      "operation": "all_gather",
      "difficulty": 1,
      "ranks": 3,
      "inputRanks": [
        [
          {
            "id": "a",
            "label": "A",
            "source": 0,
            "position": 0
          }
        ],
        [
          {
            "id": "b",
            "label": "B",
            "source": 1,
            "position": 1
          }
        ],
        [
          {
            "id": "c",
            "label": "C",
            "source": 2,
            "position": 2
          }
        ]
      ],
      "resultChunks": {
        "a": {
          "label": "A",
          "description": "Shard originally owned by rank 0."
        },
        "b": {
          "label": "B",
          "description": "Shard originally owned by rank 1."
        },
        "c": {
          "label": "C",
          "description": "Shard originally owned by rank 2."
        }
      },
      "outputRanks": [
        [
          "a",
          "b",
          "c"
        ],
        [
          "a",
          "b",
          "c"
        ],
        [
          "a",
          "b",
          "c"
        ]
      ],
      "insight": "AllGather preserves every shard and replicates the concatenated tensor. No reduction occurs.",
      "explanation": "every rank receives every source shard in the same concatenation order."
    },
